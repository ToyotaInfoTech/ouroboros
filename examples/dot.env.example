# Replace every CHANGE_ME with a strong random value (e.g. `openssl rand -hex 24`).
# The daemon, docker compose and `cargo make dshow` refuse to start without these.

# Database credentials (used by daemon config TOML via ${VAR} expansion).
# The password must match POSTGRES_PASSWORD; use only URL-safe characters (hex is fine).
DATABASE_URL=postgres://ouro:CHANGE_ME@localhost:5432/ouroboros

# Docker Compose
POSTGRES_USER=ouro
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ouroboros
# PostgreSQL is published on loopback only; set to 0.0.0.0 only on a trusted network
#POSTGRES_BIND=127.0.0.1

# Password for `cargo make dshow` / `dclear` / `ddrop` (same as POSTGRES_PASSWORD)
PGPASSWORD=CHANGE_ME

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME

# WebUI / metrics listen addresses (default: loopback only)
#OURO_WEBUI_BIND=0.0.0.0:3001
#OURO_METRICS_BIND=0.0.0.0:8080
# Bearer token required by the WebUI API; use only [A-Za-z0-9_-] characters
# (generate one with: openssl rand -hex 32). Set it whenever the bind address is not loopback.
#OURO_WEBUI_TOKEN=CHANGE_ME
