#!/usr/bin/env bash
# Sync files to remote hosts using rsync and role-based filter rules.
#
# Usage:
#   bin/ouro-sync <hostname>                  # Sync to host using its role rules
#   bin/ouro-sync --role <role>               # Sync to all hosts with given role
#   bin/ouro-sync <hostname> --rules <file>   # Sync with custom rules file
#   bin/ouro-sync <hostname> --dry-run        # Preview without transferring
#   bin/ouro-sync --role all                  # Sync to all hosts
#
# Environment:
#   OURO_SYNC_OPTS  Extra rsync options (e.g. "--delete")

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "${SCRIPT_DIR}")"

# Activate project venv if available (for parse-hosts.py / tomllib)
if [[ -f "${ROOT}/.venv/bin/activate" ]]; then
    . "${ROOT}/.venv/bin/activate"
fi

# Defaults
DRY_RUN=""
CUSTOM_RULES=""
TARGET_HOST=""
TARGET_ROLE=""

usage() {
    cat <<'EOF'
Usage: bin/ouro-sync [OPTIONS] [<hostname>]

Options:
  --role <role>     Sync to all hosts with given role (cloud/head/work/all)
  --rules <file>    Use custom rsync filter rules file
  --dry-run         Preview files to sync without transferring
  -h, --help        Show this help

Examples:
  bin/ouro-sync ouro-1                    # Sync to ourocloud
  bin/ouro-sync --role cloud              # Sync to all cloud hosts
  bin/ouro-sync --role all                # Sync to all hosts
  bin/ouro-sync ouro-1 --dry-run          # Preview only
  bin/ouro-sync ouro-1 --rules etc/sync-cloud.rules
EOF
    exit "${1:-0}"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --role)
            TARGET_ROLE="$2"
            shift 2
            ;;
        --rules)
            CUSTOM_RULES="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN="--dry-run"
            shift
            ;;
        -h|--help)
            usage 0
            ;;
        -*)
            echo "Error: unknown option $1" >&2
            usage 1
            ;;
        *)
            TARGET_HOST="$1"
            shift
            ;;
    esac
done

if [[ -z "${TARGET_HOST}" && -z "${TARGET_ROLE}" ]]; then
    echo "Error: specify a hostname or --role" >&2
    usage 1
fi

# Resolve the list of (hostname, ssh_target, remote_dir, first_role) tuples
declare -a TARGETS=()

resolve_host() {
    local hostname="$1"
    local info
    info=$(python3 "${SCRIPT_DIR}/parse-hosts.py" info "${hostname}")
    local ssh_target remote_dir roles
    ssh_target=$(echo "${info}" | cut -d' ' -f1)
    remote_dir=$(echo "${info}" | cut -d' ' -f2)
    roles=$(echo "${info}" | cut -d' ' -f3)
    local first_role="${roles%%,*}"
    TARGETS+=("${hostname}|${ssh_target}|${remote_dir}|${first_role}")
}

if [[ -n "${TARGET_HOST}" ]]; then
    resolve_host "${TARGET_HOST}"
elif [[ -n "${TARGET_ROLE}" ]]; then
    hostnames=$(python3 "${SCRIPT_DIR}/parse-hosts.py" role "${TARGET_ROLE}")
    for h in ${hostnames}; do
        resolve_host "${h}"
    done
fi

# Sync each target
for entry in "${TARGETS[@]}"; do
    IFS='|' read -r hostname ssh_target remote_dir first_role <<< "${entry}"

    # Determine rules file
    if [[ -n "${CUSTOM_RULES}" ]]; then
        rules_file="${CUSTOM_RULES}"
    else
        rules_file="${ROOT}/etc/sync-${first_role}.rules"
    fi

    if [[ ! -f "${rules_file}" ]]; then
        echo "Error: rules file not found: ${rules_file}" >&2
        exit 1
    fi

    echo "=== Syncing to ${hostname} (${ssh_target}:${remote_dir}) using ${rules_file##*/} ==="

    rsync -avz \
        --filter="merge ${rules_file}" \
        -e "ssh -o ClearAllForwardings=yes" \
        ${DRY_RUN} \
        ${OURO_SYNC_OPTS:-} \
        "${ROOT}/" \
        "${ssh_target}:${remote_dir}/" \
        --delete \

    ssh -o ClearAllForwardings=yes "${ssh_target}" "cd ${remote_dir} && [ -f "pyproject.toml" ] && uv sync || true"

    echo "=== Done: ${hostname} ==="
    echo
done
