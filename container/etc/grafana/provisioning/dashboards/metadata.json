          "rawQuery": true,
          "rawSql": "SELECT\n  (metadata->'vehicle'->>'vin')::int AS vin,\n  (fix->>'latitude')::float  AS latitude,\n  (fix->>'longitude')::float AS longitude\nFROM telemetry,\nLATERAL jsonb_array_elements(metadata->'trajectory'->'location_fixes') AS fix\nWHERE start_time >= NOW() - INTERVAL '30 minutes';",
